# --- Server ---
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://arcade:arcade@localhost:5432/arcade_dev
# DB_SSL=true            # force TLS (auto-on for *.render.com external URLs)
PUBLIC_URL=http://localhost:4000
# COOKIE_SECURE=true          # default true in production
# TRUST_PROXY=1               # when behind a reverse proxy / load balancer
# UPLOAD_DIR=/var/lib/smartcard/uploads

# --- Initial Owner (created once at first boot; password is hashed, never stored in plain text) ---
# If not set, the server prints a one-time SETUP TOKEN and the owner is created via /setup.
OWNER_USERNAME=
OWNER_PASSWORD=
OWNER_PIN=
OWNER_EMPLOYEE_CODE=OWNER
OWNER_FIRST_NAME=Owner
# SETUP_TOKEN=                # optional fixed setup token instead of a random one

# --- Payments ---
# mock = TEST MODE gateway (never allowed in production). Implement an adapter in
# server/src/integrations/payment/ and set its name here for a real provider.
PAYMENT_GATEWAY=mock
PAYMENT_WEBHOOK_SECRET=change-me

# --- OTP (forgot PIN) --- console (dev only) | none | <your adapter>
OTP_PROVIDER=console
# --- Email receipts --- console | webhook | none
EMAIL_PROVIDER=console
# EMAIL_WEBHOOK_URL=
# EMAIL_WEBHOOK_TOKEN=

# --- AI promotion copy (optional; template copy is used when unset) ---
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
